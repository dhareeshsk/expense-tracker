generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  passwordHash     String
  role             Role      @default(USER)
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())

  transactions     Transaction[]
  categories       Category[]
  budgets          Budget[]
  memberships      HouseholdMember[]
  transactionTypes  TransactionType[]
  calculators       Calculator[]
  reminders         Reminder[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
}

enum Role {
  USER
  SUPER_ADMIN
}

model SiteSettings {
  id         String   @id @default("singleton")
  siteName   String   @default("ExpenseTrack")
  footerText String   @default("")
  updatedAt  DateTime @updatedAt
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members      HouseholdMember[]
  transactions Transaction[]
  budgets      HouseholdBudget[]
  invites      HouseholdInvite[]
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([householdId, userId])
}

model HouseholdInvite {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  email       String
  createdAt   DateTime  @default(now())

  @@unique([householdId, email])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  icon      String?
  isDefault Boolean  @default(false)

  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
}

model Transaction {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  transactionTypeId String
  transactionType   TransactionType @relation(fields: [transactionTypeId], references: [id])
  amount            Decimal
  date              DateTime
  note              String?
  paymentMethod     String?
  householdId       String?
  household         Household?      @relation(fields: [householdId], references: [id])
  createdAt         DateTime        @default(now())

  @@index([userId, date])
  @@index([householdId, date])
  @@index([userId, categoryId])
  @@index([transactionTypeId])
}

model TransactionType {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String?
  isDefault Boolean @default(false)

  transactions Transaction[]

  @@unique([userId, name])
}

model Budget {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  monthlyLimit   Decimal
  alertThreshold Int      @default(80)

  @@unique([userId, categoryId])
}

model HouseholdBudget {
  id             String    @id @default(cuid())
  householdId    String
  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  categoryName   String
  monthlyLimit   Decimal
  alertThreshold Int       @default(80)

  @@unique([householdId, categoryName])
}

enum CalculatorType {
  EXPENSE_SPLIT
  BUDGET
}

model Calculator {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      CalculatorType
  name      String
  data      Json
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, type])
}

enum ReminderStatus {
  PENDING
  PAID
  MISSED
}

// Interval choice for recurring reminders. Extended beyond the spec's
// "monthly repeat" default per explicit decision: weekly/custom intervals
// are also needed (not just EMI/rent/utility-style monthly obligations).
enum RecurrenceInterval {
  WEEKLY
  MONTHLY
  CUSTOM_DAYS
}

model Reminder {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  label              String
  category           String
  amount             Decimal
  dueDate            DateTime
  status             ReminderStatus      @default(PENDING)
  isRecurring        Boolean             @default(false)
  recurrenceInterval RecurrenceInterval?
  customIntervalDays Int?
  createdAt          DateTime            @default(now())

  @@index([userId, dueDate])
  @@index([status])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "household", "budget_alert", "reminder"
  message   String
  // Extra id beyond the spec's minimal model, so a notification can both
  // deep-link to its source (a household, budget's category, or reminder)
  // and be de-duplicated (e.g. don't re-notify the same budget breach daily).
  relatedId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type, relatedId, createdAt])
}
